# ============================================================
# Tesla Capital — Environment Configuration Template
# Duplicate this file to .env.local and fill in your keys
# ============================================================

# ── Supabase Configuration ──────────────────────────────────
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Required for admin bypass / service role operations (Webhooks, Admin functions)
# Keep this secret — never expose to client!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Application URL ─────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend Email Integration ────────────────────────────────
# API key from: Resend Dashboard -> API Keys (starts with re_...)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Webhook Signing Secret from: Resend Dashboard -> Webhooks -> Select Webhook (starts with whsec_...)
# Used to verify inbound email webhook signatures at /api/webhooks/resend-inbound
RESEND_WEBHOOK_SECRET=whsec_abcdefghijklmnopqrstuvwxyz1234567890
